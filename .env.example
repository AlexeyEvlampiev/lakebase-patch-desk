# Settings for scripts/deploy.* and scripts/teardown.*
#
# Copy this file to .env (git-ignored) and fill in the <...> values.
# Variables already set in the environment win over this file.
# DEMO_ENV_FILE=<path> points the scripts at another file.
# Plain KEY=value lines only; the file is read, never executed.

# --- Required ---------------------------------------------------------------

# Databricks workspace URL, e.g. https://<workspace-host>
# Not needed up front with --create-workspace (taken from the new workspace).
DATABRICKS_HOST=https://<workspace-host>

# Azure subscription that holds the workspace (and the optional cost alert).
AZURE_SUBSCRIPTION_ID=<subscription-id>

# The deploy service principal: a Microsoft Entra ID app registration made
# once by hand (see docs/deploy.md). The bundle commands run as
# this app; deploy adds it to the workspace each time. The scripts never
# print the secret. It expires: renew it in Entra ID.
DEMO_DEPLOY_SP_CLIENT_ID=<application-client-id>
DEMO_DEPLOY_SP_TENANT_ID=<tenant-id>
DEMO_DEPLOY_SP_CLIENT_SECRET=<client-secret>

# --- Optional (defaults shown) ----------------------------------------------

# Who gets the cost alert mails (80 % and 100 % of the budget). Empty: no
# cost alert. Without the right to create budgets on the subscription,
# deploy warns and goes on.
DEMO_ALERT_EMAIL=

# ID of a serverless usage policy a workspace admin made by hand
# (see docs/deploy.md). Empty means none; cost tracking still
# works through the project tag, which the Lakebase project carries itself.
# The scripts never create or delete the policy.
DEMO_USAGE_POLICY_ID=

# Unity Catalog catalog the patch_export job writes to (schema patch_desk).
# Empty means the workspace's default catalog: in a new workspace, the
# workspace catalog. Deploy grants the deploy principal USE CATALOG and
# CREATE SCHEMA on it, which needs its owner (a workspace admin for the
# workspace catalog).
DEMO_EXPORT_CATALOG=

# Monthly budget for the demo's tagged spend, in the billing currency.
DEMO_BUDGET_USD=20

# Tag value on everything the demo runs (tag key: project).
# Also the name of the Azure budget.
DEMO_PROJECT_TAG=lakebase-patch-desk

# Bundle target in databricks.yml.
DEMO_BUNDLE_TARGET=demo

# Names the bundle uses. Change them only together with databricks.yml.
DEMO_APP_KEY=patch_desk
DEMO_APP_NAME=lakebase-patch-desk
DEMO_DB_JOB_KEY=db_deploy
DEMO_DB_JOB_NAME=lakebase-patch-desk-db-deploy
DEMO_EXPORT_JOB_NAME=lakebase-patch-desk-patch-export
DEMO_LAKEBASE_PROJECT_ID=lakebase-patch-desk

# Used only with --create-workspace. Pick a region where Lakebase runs.
DEMO_RESOURCE_GROUP=rg-lakebase-patch-desk
DEMO_WORKSPACE_NAME=dbw-lakebase-patch-desk
DEMO_LOCATION=westeurope
